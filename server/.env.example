# Shared secret for HTTP Bearer + Socket.IO auth.auth.token
# Leave empty for open local development.
AUTH_TOKEN=

# Set to true to force auth even if AUTH_TOKEN is empty (will lock everyone out)
# REQUIRE_AUTH=false

PORT=3001
CORS_ORIGIN=*

# Comma-separated STUN servers for WebRTC
STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN (only if calls fail to connect)
# TURN_URL=turn:your-turn.example:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
